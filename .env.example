# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini


OPENAI_INPUT_COST_PER_1M=0.75
OPENAI_OUTPUT_COST_PER_1M=4.50

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# dlt reads this, not the POSTGRES_* variables above. Without it the ingestion
# pipeline fails with a long ConfigFieldMissingException.
# Format: postgresql://user:password@localhost:5432/dbname
DESTINATION__POSTGRES__CREDENTIALS=

# fastembed models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Grafana login
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
